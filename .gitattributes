# Runtime probability tables are required but are data artifacts, so keep them in Git LFS.
source_data/**/*.npy filter=lfs diff=lfs merge=lfs -text
source_data/**/*.npz filter=lfs diff=lfs merge=lfs -text
source_data/**/*.mat filter=lfs diff=lfs merge=lfs -text

# Keep the portable replication entry points executable by bash after checkout.
run_two_lane_replication.sh text eol=lf
tools/fetch_published_d2rl_agent.sh text eol=lf

