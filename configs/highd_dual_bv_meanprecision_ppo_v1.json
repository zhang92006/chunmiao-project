{
  "schema_version": 1,
  "policy_parameterization": "mean_precision",
  "initial_epsilon": 0.1,
  "initial_precision": 80.0,
  "model": {
    "fcnet_hiddens": [64, 64],
    "fcnet_activation": "tanh",
    "vf_share_layers": false
  },
  "ppo": {
    "gamma": 1.0,
    "lambda": 1.0,
    "train_batch_size": 512,
    "sgd_minibatch_size": 128,
    "num_sgd_iter": 5,
    "lr": 0.0003,
    "entropy_coeff": 0.0,
    "vf_clip_param": 100.0,
    "vf_loss_coeff": 1.0,
    "clip_param": 0.3,
    "grad_clip": null,
    "kl_coeff": 0.2,
    "kl_target": 0.01
  }
}
