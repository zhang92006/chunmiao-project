{
  "schema_version": 1,
  "scope": "Offline state/pair discovery only; no NDE, proposal or PPO change",
  "physical_config": "configs/highd_v46_dual_context_v2.json",
  "train": {"seed_start": 160000, "episodes": 16},
  "validation": {"seed_start": 170000, "episodes": 8},
  "screen": {"nearest_actors": 8, "observation_m": 115.0, "horizon_s": 4.0,
    "gap_scale_m": 20.0, "same_side_factor": 0.6, "lateral_factor": 0.8},
  "bank": {"states_per_episode_per_method": 2, "minimum_separation_s": 5,
    "random_seed": 59, "methods": ["geometry_1s", "geometry_5s", "random_1s"]},
  "audit": {"ranked_pairs": 2, "random_remaining_pairs": 1},
  "proxy": {"horizon_s": 4.0, "step_s": 0.2, "clearance_scale_m": 2.0},
  "selection": {"minimum_delta": 0.01, "minimum_interaction": 0.05,
    "minimum_joint_excess": 0.05, "minimum_factor_tv": 0.001,
    "minimum_synergy_mass": 0.000001},
  "funnel_views": ["production_strict", "drop_global_excess", "local_interaction_actual_H"],
  "validation_rule": "Freeze implementation/config after train; run validation once with the train lock. Never change rules based on this validation cohort.",
  "environment": {"python": "3.9.19", "numpy": "1.23.1", "scipy": "1.13.1"}
}
